{
    "name": "notater-monorepo",
    "version": "0.1.1",
    "description": "An offline-first, collaborative music production workstation (DAW) running entirely in the browser. Features real-time P2P sync, AI drum generation, and a Tone.js audio engine.",
    "keywords": [
        "music-production",
        "daw",
        "offline-first",
        "collaborative",
        "p2p-sync",
        "webrtc",
        "tonejs",
        "ai-music",
        "generative-ai",
        "browser-based",
        "pwa",
        "audio-engine",
        "synthesizer",
        "sequencer",
        "nextjs",
        "typescript",
        "react",
        "webmidi",
        "web-audio-api",
        "open-source"
    ],
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mreshank/Notate.git"
    },
    "author": "mreshank",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/mreshank/Notate/issues"
    },
    "homepage": "https://github.com/mreshank/Notate#readme",
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "dev": "pnpm -r dev",
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "lint": "pnpm -r lint",
        "release": "pnpm build && pnpm publish -r --access public"
    },
    "engines": {
        "node": ">=18"
    }
}